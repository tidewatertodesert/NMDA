library(httr)
library(jsonlite)

# Your Earthdata credentials
username <- "dylanb"
password <- "&2pug?Y.Jx3ip+5"

# Authenticate and get token
auth_resp <- POST(
  url = "https://appeears.earthdatacloud.nasa.gov/api/login",
  body = list(username = username, password = password),
  encode = "json"
)

token <- content(auth_resp)$token
cat("Token:", token, "\n")

# Set up headers for API
headers <- add_headers(Authorization = paste("Bearer", token))


# Define New Mexico bounding box or polygon
nm_geojson <- list(
  "type" = "Polygon",
  "coordinates" = list(list(
    c(-109.05, 31.33),
    c(-103.00, 31.33),
    c(-103.00, 37.00),
    c(-109.05, 37.00),
    c(-109.05, 31.33)
  ))
)

# Submit area request for MOD13Q1 NDVI
task_body <- list(
  task_type = "area",
  task_name = paste0("NDVI_NM_Anomaly_", Sys.Date()),
  params = list(
    dates = list(
      list(startDate = "2025-05-01", endDate = "2025-05-08")
    ),
    layers = list(
      list(
        product = "MOD13Q1.061",
        layer = "NDVI"
      )
    ),
    output = list(
      format = "csv"
    ),
    geo = nm_geojson
  )
)

# Submit the request
submit_resp <- POST(
  url = "https://appeears.earthdatacloud.nasa.gov/api/task",
  headers,
  body = task_body,
  encode = "json"
)

task_id <- content(submit_resp)$task_id
cat("Submitted Task ID:", task_id, "\n")

# Polling for task status
repeat {
  status_resp <- GET(
    url = paste0("https://appeears.earthdatacloud.nasa.gov/api/status/", task_id),
    headers
  )
  status <- content(status_resp)$status
  cat("Status:", status, "\n")
  if (status == "done") break
  Sys.sleep(30)
}

# Get download URL
bundle_resp <- GET(
  url = paste0("https://appeears.earthdatacloud.nasa.gov/api/bundle/", task_id),
  headers
)
bundle_info <- content(bundle_resp)

# Get CSV file URL
csv_files <- Filter(function(f) grepl("\\.csv$", f$file_name), bundle_info$files)
csv_url <- csv_files[[1]]$url

# Download the file
download.file(csv_url, destfile = "NDVI_NM_Anomaly.csv", mode = "wb")

# Load it into R
ndvi_data <- read.csv("NDVI_NM_Anomaly.csv")
head(ndvi_data)
