# Load libraries
library(shiny)
library(shinydashboard)
library(tidyverse)
library(plotly)
library(DT)

# ---- Load Data ----
# Replace with your file path
df <- read_csv("C:/Users/dburruss/Documents/GitHub/NMDA/data/tables/NW_grants/combined_grant_data_13OCT25.csv")

# Ensure numeric values are parsed correctly (remove $ and commas)
df <- df %>%
  mutate(across(
    starts_with("amount"),
    ~ readr::parse_number(.)
  )) %>%
  mutate(across(
    starts_with("acres"),
    ~ readr::parse_number(.)
  ))

# ---- UI ----
ui <- dashboardPage(
  dashboardHeader(title = "NMDA Weed Management Grant Dashboard"),
  
  dashboardSidebar(
    sidebarMenu(
      menuItem("Project Explorer", tabName = "explore", icon = icon("seedling")),
      menuItem("Data Table", tabName = "table", icon = icon("table"))
    ),
    hr(),
    selectInput(
      "project",
      "Select Project Title:",
      choices = sort(unique(df$title)),
      selected = unique(df$title)[1],
      multiple = FALSE
    )
  ),
  
  dashboardBody(
    tabItems(
      # ---- Project Explorer ----
      tabItem(tabName = "explore",
              fluidRow(
                box(width = 12, title = "Project Summary", status = "primary", solidHeader = TRUE,
                    uiOutput("projSummary"))
              ),
              fluidRow(
                box(width = 4, title = "Mapping Acres vs. Requested Funds", status = "info", solidHeader = TRUE,
                    plotlyOutput("mapPlot")),
                box(width = 4, title = "EDRR Acres vs. Requested Funds", status = "info", solidHeader = TRUE,
                    plotlyOutput("edrrPlot")),
                box(width = 4, title = "Treatment Acres vs. Requested Funds", status = "info", solidHeader = TRUE,
                    plotlyOutput("treatPlot"))
              ),
              fluidRow(
                box(width = 12, title = "Funding Composition", status = "info", solidHeader = TRUE,
                    plotlyOutput("fundRelationshipPlot"))
              )
      ),
      
      # ---- Data Table ----
      tabItem(tabName = "table",
              fluidRow(
                box(width = 12, title = "Full Dataset", status = "primary", solidHeader = TRUE,
                    DTOutput("dataTable"))
              )
      )
    )
  )
)

# ---- SERVER ----
server <- function(input, output, session) {
  
  # Selected project
  proj_data <- reactive({
    df %>% filter(title == input$project)
  })
  
  # ---- Summary Box ----
  output$projSummary <- renderUI({
    d <- proj_data()
    if (nrow(d) == 0) return(NULL)
    
    tagList(
      h3(d$title[1]),
      h4(strong("Organization:"), d$name[1]),
      p(strong("Submission ID:"), d$sub_id[1]),
      p(strong("Review Stage:"), d$rev_stage[1]),
      p(strong("Summary:"), d$summary[1])
    )
  })
  
  # ---- Helper function for scatter plots ----
  make_scatter_plot <- function(data, x, y, selected_title, x_label, y_label, plot_title) {
    sel <- data %>% filter(title == selected_title)
    
    p <- ggplot(data, aes(x = .data[[x]], y = .data[[y]])) +
      geom_point(color = "gray80", size = 3, alpha = 0.6) +
      geom_point(data = sel, color = "red", size = 4) +
      geom_text(data = sel, aes(label = title),
                vjust = -0.7, color = "red", size = 3.5) +
      labs(x = x_label, y = y_label, title = plot_title) +
      theme_minimal(base_size = 14) +
      theme(
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13)
      )
    
    ggplotly(p)
  }
  
  # ---- Mapping Acres vs Requested Funds ----
  output$mapPlot <- renderPlotly({
    make_scatter_plot(
      df, "amount_req", "acres_map", input$project,
      "Total Requested Funds ($)", "Acres to Map",
      "Mapping Acres vs Requested Funds"
    )
  })
  
  # ---- EDRR Acres vs Requested Funds ----
  output$edrrPlot <- renderPlotly({
    make_scatter_plot(
      df, "amount_req", "acres_edrr", input$project,
      "Total Requested Funds ($)", "Acres (EDRR)",
      "EDRR Acres vs Requested Funds"
    )
  })
  
  # ---- Treatment Acres vs Requested Funds ----
  output$treatPlot <- renderPlotly({
    make_scatter_plot(
      df, "amount_req", "acres_trt", input$project,
      "Total Requested Funds ($)", "Acres Treated",
      "Treatment Acres vs Requested Funds"
    )
  })
  
  # ---- Funding Relationship (fixed) ----
  output$fundRelationshipPlot <- renderPlotly({
    req(input$project)
    
    req_amounts <- df %>% select(title, amount_req)
    
    funds_long <- df %>%
      select(title, amount_req, amount_match, amount_fed) %>%
      pivot_longer(cols = c(amount_req, amount_match, amount_fed),
                   names_to = "fund_type",
                   values_to = "amount") %>%
      left_join(req_amounts, by = "title")
    
    selected_funds <- funds_long %>% filter(title == input$project)
    
    p <- ggplot(funds_long, aes(x = amount_req, y = amount, color = fund_type)) +
      geom_point(color = "gray80", size = 3, alpha = 0.6) +
      geom_point(data = selected_funds, color = "red", size = 4) +
      geom_text(data = selected_funds, aes(label = title),
                vjust = -0.7, color = "red", size = 3.5) +
      scale_color_manual(
        values = c(amount_req = "#1b9e77", amount_match = "#d95f02", amount_fed = "#7570b3"),
        labels = c("Requested", "Match (Total)", "Federal Match")
      ) +
      labs(
        x = "Requested Funds ($)",
        y = "Amount ($)",
        color = "Funding Type",
        title = "Relationship Between Requested, Match, and Federal Funds"
      ) +
      theme_minimal(base_size = 14) +
      theme(
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13)
      )
    
    ggplotly(p)
  })
  
  # ---- Data Table ----
  output$dataTable <- renderDT({
    datatable(df, options = list(scrollX = TRUE, pageLength = 10))
  })
}

# ---- Run the App ----
shinyApp(ui, server)

