
library(tidyverse)
library(sf)
library(terra)
library(ggplot2)
library(tigris)
library(viridis)

#read in the most recent NDVI data
ndvi <- rast("C:/Users/dburruss/Documents/GitHub/NMDA/Drought_Monitor_WG/NDVI_data/GMOD09Q1.A2025121.08d.latlon.global.061.NDVI_anom_S2001-2023 (1).tif")
ndvi

#grab NM county boundaries
nm_co <- counties(state = "NM", cb = TRUE) %>%  # cb = TRUE for simplified geometries
  st_transform(crs=st_crs(ndvi)) %>%
  select(NAME, NAMELSAD) %>%
  rename(County = NAME,
         County_lsad = NAMELSAD)

#mask ndvi anomoly data to NM
NM_ndvi <- crop(ndvi, nm_co)
NM_ndvi <- mask(NM_ndvi, nm_co)

#convert from NDVI 8-bit unsigned integer [0 - 250] to floating-point [0.0 - 1.0]
NM_ndvi[NM_ndvi > 250] <- NA
NM_ndvi <- (NM_ndvi - 125) * 0.008

plot(NM_ndvi, 
     col = rev(turbo(10)), 
     axes = FALSE, 
     box = FALSE,
     main = "NDVI Anomaly")
plot(nm_co, 
     add = TRUE, 
     col = NA, 
     border = "black")

#read in the landcover data
nlcd <- rast("C:/Users/dburruss/Documents/GIS/nlcd_NM_2019/nlcd_NM_2019.tif") %>%
  project(crs(ndvi)) 

nlcd_df <- nlcd %>%
  as.data.frame(xy = FALSE, cells = TRUE, na.rm = FALSE) %>%
  filter(`NLCD Land Cover Class` %in% c(
    "Deciduous Forest",
    "Evergreen Forest",
    "Mixed Forest",
    "Shrub/Scrub",
    "Hay/Pasture",
    "Cultivated Crops"
  )) 

NM_ndvi_df <- NM_ndvi %>% 
  resample(nlcd) %>%
  mask(nlcd) %>%
  as.data.frame(xy = FALSE, cells = TRUE, na.rm = FALSE)


#plot

plot_data <- left_join(nlcd_df,NM_ndvi_df) %>%
  drop_na()

head(plot_data)

p1 <- ggplot(plot_data, aes(x = `NLCD Land Cover Class`, y = `GMOD09Q1.A2025121.08d.latlon.global.061.NDVI_anom_S2001-2023 (1)`)) +
  geom_boxplot() +
  theme_minimal()

ggsave(filename = "C:/Users/dburruss/Documents/GitHub/NMDA/Drought_Monitor_WG/figures/test_p1.jpg", plot = p1)

p2 <- ggplot(plot_data, aes(x = `NLCD Land Cover Class`, y = `GMOD09Q1.A2025121.08d.latlon.global.061.NDVI_anom_S2001-2023 (1)`)) +
  geom_violin(trim = FALSE) +
  theme_minimal()

ggsave(filename = "C:/Users/dburruss/Documents/GitHub/NMDA/Drought_Monitor_WG/figures/test_p2.jpg", plot = p2)
