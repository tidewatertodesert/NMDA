library(ggplot2)
library(sf)
library(terra)
library(rnaturalearth)
library(rnaturalearthdata)
library(maptiles)

# -----------------------------
# 1. Get Paraguay polygon
# -----------------------------
world <- ne_countries(scale = "medium", returnclass = "sf")
paraguay <- subset(world, name_long == "Paraguay")

# -----------------------------
# 2. Define bounding box with buffer
# -----------------------------
bbox_paraguay <- st_bbox(st_buffer(st_union(paraguay), dist = 0.05))

# -----------------------------
# 3. Grab basemap tiles (More maps avaialble, see https://cran.r-project.org/web/packages/maptiles/readme/README.html)
# -----------------------------
paraguay_basemap <- get_tiles(
  x = bbox_paraguay, 
  provider = "Esri.WorldImagery", # "Esri.WorldShadedRelief"
  zoom = 8
)

# -----------------------------
# 4. Convert SpatRaster to ggplot-friendly data frame
# -----------------------------
basemap_df <- as.data.frame(paraguay_basemap, xy = TRUE)
names(basemap_df)[3:5] <- c("R", "G", "B")  # name RGB bands
basemap_df$hex <- rgb(basemap_df$R, basemap_df$G, basemap_df$B, maxColorValue = 255)

# -----------------------------
# 5. Plot in ggplot
# -----------------------------
ggplot() +
  geom_raster(data = basemap_df, aes(x = x, y = y, fill = hex)) +
  scale_fill_identity() +                     # use the RGB colors directly
  geom_sf(data = paraguay, fill = NA, color = "red", size = 0.8) +
  coord_sf(xlim = c(-62.5, -54), ylim = c(-28, -19)) +
  theme_minimal() +
  ggtitle("Paraguay with OpenStreetMap Basemap")

