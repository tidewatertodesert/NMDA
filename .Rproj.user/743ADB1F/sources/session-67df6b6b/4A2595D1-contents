library(terra)
library(sf)
library(tigris)
library(dplyr)
library(ggplot2)

#--------------------------------------------------------------------
# Paths
#--------------------------------------------------------------------
input_folder <- "C:/Users/dburruss/Documents/GIS/Drought_Monitor/GIMMS_data/10.2025"
output_folder <- file.path(input_folder, "plots")

# Create output folder if it doesn’t exist
if (!dir.exists(output_folder)) dir.create(output_folder, recursive = TRUE)

#--------------------------------------------------------------------
# Get file list
#--------------------------------------------------------------------
tif_files <- list.files(input_folder, pattern = "\\.tif$", full.names = TRUE)
tif_files
#--------------------------------------------------------------------
# Load NM boundaries once (outside loop)
#--------------------------------------------------------------------
nm_state <- states(cb = TRUE) %>%
  filter(STUSPS == "NM")

nm_counties <- counties(state = "NM", cb = TRUE)

#--------------------------------------------------------------------
# Loop through each NDVI anomaly file
#--------------------------------------------------------------------
for (f in tif_files) {
  
  message("Processing: ", basename(f))
  
  # Extract composite info from filename (e.g., "88d" or "08d")
  composite <- stringr::str_extract(basename(f), "\\d{2}d")
  
  # Read raster
  ndvi_anom <- rast(f)
  
  # Transform and crop boundaries to match raster CRS
  nm_state_t <- st_transform(nm_state, crs(ndvi_anom))
  nm_counties_t <- st_transform(nm_counties, crs(ndvi_anom))
  
  # Crop and mask NDVI to NM
  ndvi_nm <- crop(ndvi_anom, nm_state_t)
  ndvi_nm <- mask(ndvi_nm, nm_state_t)
  
  # Convert raster to data frame for plotting
  df_map <- as.data.frame(ndvi_nm, xy = TRUE, na.rm = TRUE)
  names(df_map)[3] <- "value"
  
  # Define breaks and color bins
  breaks <- c(0, 75, 90, 110, 125, 250)
  labels <- paste0(head(breaks, -1), " to ", tail(breaks, -1))
  
  df_map <- df_map %>%
    mutate(bin = cut(value, breaks = breaks, labels = labels, include.lowest = TRUE))
  
  # Define color palette
  colors_manual <- c("#ff0000", "#ffff00", "#edf5dc", "#52ff00", "#217100")
  
  #----------------------------------------------------------------
  # Plot
  #----------------------------------------------------------------
  p <- ggplot() +
    geom_raster(data = df_map, aes(x = x, y = y, fill = bin)) +
    geom_sf(data = nm_counties_t, fill = NA, color = "gray25", linewidth = 0.2) +
    scale_fill_manual(
      values = colors_manual,
      name = "NDVI anomaly (%)",
      drop = FALSE
    ) +
    coord_sf() +
    theme_classic() +
    theme(
      legend.key.height = unit(0.6, "cm"),
      legend.text = element_text(size = 8),
      legend.title = element_text(size = 10),
      panel.grid = element_blank()
    ) +
    labs(
      title = paste0("NDVI Percent Anomaly – ", composite, " Composite"),
      subtitle = "GIMMS NDVI_pasg (percent of 2001–2024 mean)",
      x = NULL, y = NULL
    )
  
  #----------------------------------------------------------------
  # Save plot
  #----------------------------------------------------------------
  out_file <- file.path(output_folder, paste0("NDVI_Anomaly_", composite, ".png"))
  ggsave(out_file, plot = p, width = 7, height = 5, dpi = 300)
}

message("✅ All plots saved to: ", output_folder)