#try to quantify drought intensity
nm_summary <- nm_summary %>%
  mutate(
    drought_class = case_when(
      mean <= -2 ~ "Extreme",
      mean <= -1 ~ "Moderate",
      mean <= -0.5 ~ "Mild",
      mean > -0.5 ~ "Normal or Greener"
    )
  )

ggplot(nm_summary) +
  geom_sf(aes(fill = drought_class)) +
  scale_fill_manual(values = c("Extreme" = "darkred", "Moderate" = "red",
                               "Mild" = "orange", "Normal or Greener" = "green")) +
  theme_minimal() +
  labs(title = "NDVI-based Drought Classes – New Mexico")

