library(tidyverse)
library(readxl)
library(stringr)

f_fy25_ee <- "HSP/ESRI_online_map/2025-2026_data/FY25 HSP EE all export.xlsx"
f_fy25_ia <- "HSP/ESRI_online_map/2025-2026_data/FY25 HSP IA all export.xlsx"
f_fy26_ee <- "HSP/ESRI_online_map/2025-2026_data/FY26 HSP EE all export.xlsx"
f_fy26_ia <- "HSP/ESRI_online_map/2025-2026_data/FY26 HSP IA all export.xlsx"

fy25_ee <- read_excel(f_fy25_ee) %>%
  rename_with(~ str_remove(.x, "\\s*\\([^)]*\\)$")) %>%
  drop_na(`Project Title`) %>%
  mutate(
    ID = paste0(
      str_remove(str_extract(f_fy25_ee, "HSP\\s+[A-Z]{2}"), "\\s+"),
      "-25-",
      `Project Title`
    ),
    Project_Ti  = `Project Title`,
    Grantee     = `What is the name of the Eligible Entity?`,
    Grantee_Ty  = `Which Eligible Entity type best describes your organization?`,
    Project_Ye  = 2025,
    Project_Sp  = "Eligible Entity",
    County      = `In which New Mexico county is the project site located?`,
    Acres       = `What is the amount of land involved in the project?`,
    Project_La  = `What is the land type of the project site?  Select all that apply.`,
    Amount_Spe  = `What is the total amount of Healthy Soil Program funding you are requesting to implement the project?`,
    Practices   = `Which category(ies) of agricultural / conservation practice will the project utilize in order to implement the soil health principle(s) identified in the previous question?  Select all that apply.`,
    Project_Su  = `Provide your project summary below.`,
    Town        = `What is the physical address of the project site? : City`,
    Zip_Code    = `What is the physical address of the project site? : Postal Code`
  ) %>%
  select(ID, Project_Ti, Grantee, Grantee_Ty, Project_Ye, Project_Sp,
         County, Acres, Project_La, Amount_Spe, Practices,
         Project_Su, Town, Zip_Code)

